6 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0456\u044e.\n\n\u041d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u043c\u0443 \u0431\u043e\u0446\u0456 \u043a\u0430\u0440\u0442\u043a\u0438 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u0438\u0439 HTML, \u044f\u043a-\u043e\u0442 <b>, <i> \u0456 <br />.'},kebabMenu:{triggerA11yLabel:'\u0406\u043d\u0448\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438'},searchBar:{inputA11yLabel:'\u0422\u0435\u043a\u0441\u0442 \u043f\u043e\u0448\u0443\u043a\u0443',closeButtonA11yLabel:'\u0417\u0430\u043a\u0440\u0438\u0442\u0438 \u043f\u043e\u0448\u0443\u043a'}},settings:{settingsScreen:{title:'\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f',generalSection:'\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0456',appSection:'\u0417\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a',communitySection:'\u0421\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0430 \u0439 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0430',legalSection:'\u041f\u0440\u0430\u0432\u043e\u0432\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f',changeLanguageItem:'\u0417\u043c\u0456\u043d\u0438\u0442\u0438 \u043c\u043e\u0432\u0443',shareAppItem:'\u041f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u043e\u043c',shareMessage:'\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 Easy Flashcards \u2014 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0434\u043b\u044f \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f \u043a\u043e\u043b\u043e\u0434 \u043a\u0430\u0440\u0442\u043e\u043a: {url}',rateAppItem:'\u041e\u0446\u0456\u043d\u0438\u0442\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a',customerSupportItem:'\u0421\u043b\u0443\u0436\u0431\u0430 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438',aboutItem:'\u041