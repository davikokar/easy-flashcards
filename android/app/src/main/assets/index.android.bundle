\uc815\uc0c1\uc758 \uae43\ubc1c',sunny:'\ud574',mixture_med:'\uc8fc\uc0ac\uae30\uc640 \uc54c\uc57d',temple_buddhist:'\uc0ac\uc6d0',text_snippet:'\ud14d\uc2a4\ud2b8 \ubb38\uc11c',theater_comedy:'\uc5f0\uadf9 \uac00\uba74',nest_thermostat_gen_3:'\uc628\ub3c4 \uc870\uc808\uae30',translate:'\ubc88\uc5ed',nature:'\ub098\ubb34',fertile:'\ud2a4\ub9bd',videocam:'\ube44\ub514\uc624 \uce74\uba54\ub77c',coronavirus:'\ubc14\uc774\ub7ec\uc2a4',volcano:'\ud654\uc0b0',warning:'\uacbd\uace0',water:'\ubb3c\uacb0',air:'\ubc14\ub78c',build:'\ub80c\uce58'}},shell:{appMenu:{triggerA11yLabel:'\uc571 \uba54\ub274',exportSampleDeckItem:'\uc0d8\ud50c \ub371 \ub0b4\ubcf4\ub0b4\uae30',settingsItem:'\uc124\uc815'},exportSampleDeckDialog:{title:'\uc0d8\ud50c \ub371 \ub0b4\ubcf4\ub0b4\uae30',body:'\uac19\uc740 \uc0d8\ud50c \ub371\uc744 CSV\uc640 JSON, \ub450 \uac1c\uc758 \ud30c\uc77c\ub85c \uc800\uc7a5\ud574\uc694. \ud30c\uc77c\ub9c8\ub2e4 \uc800\uc7a5\ud560 \uc704\uce58\ub97c \ubb3b\ub294\ub370, \ucde8\uc18c\ud558\uba74 \ud574\ub2f9 \ud30c\uc77c\uc740 \uac74\ub108\ub6f0\uc5b4\uc694.\n\nCSV: # \uae30\ud638\ub85c \uc2dc\uc791\ud558\ub294 \uc904(\uc81c\ubaa9, \uc124\uba85, \uce74\ud14c\uace0\ub9ac)\uc740 \uac00\uc838\uc62c \ub54c \uac74\ub108\ub6f0\uace0, \uadf8\ub2e4\uc74c "question" / "answer" \ud5e4\ub354\uc640 \uce74\ub4dc\ub2f9 \ud55c \ud589\uc774 \uc774\uc5b4\uc838\uc694. \uc5ec\uae30\uc11c\ub294 \uc138\ubbf8\ucf5c\ub860\uc73c\ub85c \uad6c\ubd84\ud558\uc9c0\ub9cc \uc27c\ud45c, \ud0ed, \ub2e4\ub978 \uae30\ud638 \ud55c \uac1c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc5b4\uc694.\n\nJSON: \uc81c\ubaa9, \uc124\uba85, \uce74\ud14c\uace0\ub9ac\ub3c4 \ud568\uaed8 \ubcf5\uc6d0\ud574\uc694.\n\n\uce74\ub4dc\uc758 \uc591\uba74\uc5d0\ub294 <b>, <i>, <br /> \uac19\uc740 \uae30\ubcf8 HTML\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc5b4\uc694.'},kebabMenu:{triggerA11yLabel:'\uc635\uc158 \ub354\ubcf4\uae30'},searchBar:{inputA11yLabel:'\uac80\uc0c9\uc5b4',closeButtonA11yLabel:'\uac80\uc0c9 \ub2eb\uae30'}},setting